{
  "name": "drone-inspection-system",
  "version": "1.0.0",
  "description": "无人机智能巡检系统 - 端边云协同的智能巡检平台",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "install:backend": "cd backend && npm install",
    "install:all": "npm install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.15.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "backend/utils/**/*.js",
      "backend/routes/**/*.js",
      "backend/data/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "verbose": true,
    "forceExit": true
  }
}
