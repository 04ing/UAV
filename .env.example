# ============ 应用配置 ============
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ============ 安全配置 ============
# 生产环境必须修改！建议使用: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=8h

# ============ DJI 上云 API ============
# 申请地址：https://developer.dji.com/user/register
DJI_APP_KEY=
DJI_APP_SECRET=
DJI_API_URL=https://api.dji.com

# ============ Docker Compose 端口映射 ============
HTTP_PORT=80
YOLO_PORT=8080
