FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
RUN pip install --no-cache-dir \
    ultralytics \
    flask \
    pillow \
    numpy

# 复制 YOLO 服务代码
COPY yolo_server.py ./
COPY data.yaml ./

EXPOSE 8080

CMD ["python", "yolo_server.py"]
